# Backend
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

# Database (SQLite by default; swap for a PostgreSQL URL later)
DATABASE_URL=sqlite:///./data/bitcoin_forecasting.db

# Optional: only needed if a future market-data source requires a key
# (yfinance does not). Never commit the real value — copy this file to
# .env (gitignored) and fill it in there.
MARKET_DATA_API_KEY=
